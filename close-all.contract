// The alert that asks before the tabs of a page close. The cards of the tabs in view fly from the
// grid into a stack and sink into a frosted bin. On Close they drop into the bin and the alert
// leaves; on Cancel they fly back to their places in the grid. @ref LLP 0001#close-all
use Icon from "./icons.contract"
use Tab, TabFace from "./tabs.contract"
use Bare, TypeLg, WashIn, WashOut, ScaleIn, ScaleOut, FadeIn, FadeOut, BinIn, BinOut, ArcRise, ArcSink, CardIn, CardBack, CardHold, CardFall from "./design.contract"

// A card in the stack, and where it was in the grid when the alert opened.
shape BinCard
  tab: Tab
  at: Geometry

// The stack fans its cards: the back one turns to the left, the front one to the right and sits
// lower. `t` is a card's place in the stack, 0 at the back and 1 at the front.
fn fanT(i: number, n: number): number = n <= 1 ? 0.5 : i / (n - 1)
fn fanTurn(i: number, n: number): number = n <= 1 ? 0 : -8 + 11 * fanT(i, n)
fn fanX(i: number, n: number): number = n <= 1 ? 0 : -20 + 30 * fanT(i, n)
fn fanY(i: number, n: number): number = n <= 1 ? 0 : 10 * fanT(i, n)

component CloseAllAlert
  props
    // "lift": the alert is drawn in its first state, the cards on their places in the grid. "in":
    // it shows, and the cards fly to the stack and rise over the bin. "rest": the cards sink into
    // the bin. "ready": they are at rest in it. "drop": they fall into it. "hold": the bin is
    // empty. "out": the alert leaves after Close. "back": it leaves after Cancel, and the cards fly
    // back.
    phase: string
    cards: BinCard[]
    current: string
    private: bool
    // The tabs on the page, and the tabs of the other kind, which stay.
    count: number
    others: number
    width: number
    height: number
    centerX: number
    safeTop: number
    safeBottom: number
    cardWidth: number
    previewHeight: number
    confirm: action
    cancel: action
  // The bin's size follows the screen's height; the cards take the scale that fits them in it.
  // The bin is a cup seen from a little above: `binW` across its rim, narrower by `taper` on each
  // side at its bottom. Its opening is an ellipse 28 points high, and its bottom curves the same way.
  derive taper = 22
  derive binH = max(100, min(232, min((height - safeTop - safeBottom) * 0.33, height - safeTop - safeBottom - 274)))
  derive binW = binH
  // How much of the front card shows above the bin's rim.
  derive peek = 72
  // How far a card rises over the bin on its way in. A card is tall, so it rises far enough that
  // it does not hang below the bin as it comes in.
  derive lift = 120
  // From the icon's top to Cancel's bottom: the icon, the title and the message, the stack above
  // the rim, the bin, the button and Cancel.
  derive blockH = 320 + binH
  derive top = max(safeTop + 16, (height - blockH) / 2 - 12)
  derive rim = top + min(192, max(132, height - safeTop - safeBottom - binH - 158))
  derive binBottom = rim + binH
  derive cardH = 44 + previewHeight
  // A card fits in the bin with 16 points to spare at the bottom, and is at most 0.64 of its width.
  derive stackScale = min((binH + peek - 16) / cardH, 0.64 * binW / cardWidth)
  derive n = cards.length
  derive textW = min(width - 64, 320)
  derive buttonW = min(width - 64, 300)
  derive leaving = phase == "out" or phase == "back"
  derive title = count == 1 ? (private ? "Close Private Tab" : "Close Tab") : (private ? "Close All Private Tabs" : "Close All Tabs")
  derive message = count == 1 ? "This tab closes." : "Every tab on this page closes."
  derive label = count == 1 ? "Close Tab" : `Close ${count} Tabs`
  derive note = private ? "Your regular tabs stay open." : "Your private tabs stay open."
  derive falling = phase == "drop" or phase == "hold" or phase == "out"
  derive shown = phase == "in" or phase == "rest" or phase == "ready" or phase == "drop" or phase == "hold"
  // What is outside the bin below its rim is cut off from when the cards start to sink into it,
  // so no card hangs below the bin's bottom, and a card can fall through the bottom out of sight.
  // By then each card is near the stack and inside the bin's walls; before, the cards still fly
  // from places in the grid that the cut would hide.
  derive cut = phase == "rest" or phase == "ready" or falling
  derive home = phase == "lift" or phase == "back"
  derive buttonTop = binBottom + 32
  derive binL = centerX - binW / 2
  derive binR = centerX + binW / 2
  derive blurred = phase == "ready" or phase == "drop" or phase == "hold"
  // Under the cut, a card shows above the rim and inside the bin's walls, and not below its bottom.
  derive cardCut = `polygon(0px 0px, ${width}px 0px, ${width}px ${rim}px, ${binR}px ${rim}px, ${binR - taper}px ${binBottom - 12}px, ${binL + taper}px ${binBottom - 12}px, ${binL}px ${rim}px, 0px ${rim}px)`
  view
    // The app draws this alert, as the cards fly into it: a native alert has no room for them. The
    // grid and the bar under it are inert while it shows (app.contract).
    // exact-accept lower-dialog-role
    box position="absolute" left=0 top=0 width=width height=height z-index=(phase == "back" ? 0 : 2) role="alertdialog" aria-modal=true aria-label=title testId="close-all"
      // The grid behind washes out to white. It does not blur: on iOS a filter is drawn as a picture
      // of its box, and a picture of the grid stopped the frames for about 100 ms.
      box class=(shown ? WashIn : WashOut) background-color="veil.wash" aria-hidden=true testId="close-all-veil"
      // The words and the buttons come in from a little larger, and leave the same way.
      box class=(shown ? ScaleIn : ScaleOut)
        box position="absolute" left=(centerX - textW / 2) top=top width=textW height=150
          column class=(shown ? FadeIn : FadeOut) width=textW height=150 align-items="center"
            box height=32 display="flex" align-items="center"
              Icon(name="close-all", size=28, color="color.danger", weight=600)
            text title class=TypeLg color="color.text" text-align="center" margin-top=14 testId="close-all-title"
            text message font-size=15 line-height="20px" font-weight=500 color="color.text-secondary" text-align="center" margin-top=8 testId="close-all-message"
            text "This can’t be undone." font-size=15 line-height="20px" font-weight=500 color="color.text-secondary" text-align="center"
        button press=cancel class=Bare position="absolute" left=(centerX - buttonW / 2) top=(buttonTop + 60) width=buttonW height=44 display="flex" align-items="center" justify-content="center" testId="close-all-cancel"
          text "Cancel" class=(shown ? FadeIn : FadeOut) font-size=17 font-weight=500 color="color.text-secondary"
        if others > 0
          text note class=(shown ? FadeIn : FadeOut) position="absolute" left=(centerX - textW / 2) bottom=(safeBottom + 24) width=textW font-size=12 font-weight=500 color="color.text-secondary" text-align="center" testId="close-all-note"
      // The Close button is the platform's prominent glass button, tinted with the danger red: the
      // whole button swells and lights under a finger. It shows while the alert is at rest (`blurred`).
      // On iOS a glass is not drawn while it or an ancestor fades or scales, so as the alert comes
      // in and leaves, a plain red button of the same shape stands in its place and fades. The two
      // change places while the alert is still, and both answer a press. Only one shows at a time:
      // the glass over the plain red would darken it.
      button press=confirm class=(shown ? FadeIn : FadeOut) visibility=(phase == "lift" or blurred ? "hidden" : "visible") position="absolute" left=(centerX - buttonW / 2) top=buttonTop width=buttonW height=52 border-radius="radius.full" background-color="color.danger" display="flex" align-items="center" justify-content="center" testId="close-all-stand-in"
        text label font-family="system-ui" font-size=17 font-weight=400 color="color.on-accent"
      button appearance="auto" buttonStyle="prominent-glass" accent-color="color.danger" press=confirm visibility=(blurred ? "visible" : "hidden") position="absolute" left=(centerX - buttonW / 2) top=buttonTop width=buttonW height=52 testId="close-all-confirm"
        text label testId="close-all-label"
      // The cards. A card is taller than the bin is deep, so what is outside the bin below its rim
      // is cut off (`cut`), and a card falls through the bin's bottom out of sight.
      box position="absolute" left=0 top=0 width=width height=height clip-path=(cut ? cardCut : "none") pointer-events="none" aria-hidden=true
        for c, i in cards key=c.tab.id
          box class=(phase == "in" ? ArcRise : ArcSink) width=cardWidth height=cardH translate=(phase == "in" ? `0px ${0 - lift}px` : "0px 0px")
            box class=(falling ? CardFall : CardHold) width=cardWidth height=cardH
              box class=(phase == "back" ? CardBack : CardIn) width=cardWidth height=cardH
                translate=(home ? `${c.at.x}px ${c.at.y}px` : `${centerX + fanX(i, n) - cardWidth / 2}px ${rim - peek + fanY(i, n) + cardH * stackScale / 2 - cardH / 2}px`)
                scale=(home ? 1 : stackScale)
                rotate=(home ? "0deg" : `${fanTurn(i, n)}deg`)
                TabFace(tab=c.tab, selected=(c.tab.id == current), width=cardWidth, previewHeight=previewHeight)
      image "assets/wastebasket.png" class=(shown ? BinIn : BinOut) left=binL top=rim width=binW height=binH object-fit="contain" alt="" pointer-events="none" testId="close-all-bin"
