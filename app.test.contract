// The browser's chrome: the bar, its two sheets and the tab grid.
test "the address pill opens the search sheet on the page's address"
  expect state sheet == "none"
  tap "bar-middle"
  expect state sheet == "search"
  expect state composing == false
  expect state draft == "https://expo.dev/"
  clock +300
  expect focused "address"
  tap "scrim"
  expect state sheet == "none"

test "the clear button empties the field and keeps it focused"
  tap "bar-middle"
  clock settle
  expect state draft == "https://expo.dev/"
  tap "clear"
  expect state draft == ""
  expect text "address" == ""
  expect focused "address"

test "the chevron opens the page menu, and a press beside it closes it"
  expect state tabs.0.desktopSite == false
  tap "bar-right"
  expect state sheet == "menu"
  expect tree has "menu-summarize"
  tap "scrim"
  expect state sheet == "none"
  expect tree missing "menu-summarize"

test "Find on Page targets the current iOS tab and closes the menu" on ios
  tap "bar-right"
  clock settle
  tap "menu-find"
  expect state sheet == "none"
  expect state findTab == "1"
  expect state findRequest == 1

test "the web page menu omits native Find on Page" on web
  tap "bar-right"
  clock settle
  expect tree has "menu-share"
  expect tree missing "menu-find"
  expect state findRequest == 0

test "the address in the page menu turns the menu into the search sheet"
  tap "bar-right"
  clock settle
  tap "menu-address"
  expect state sheet == "search"
  expect state draft == "https://expo.dev/"
  expect tree missing "menu-summarize"
  clock +300
  expect focused "address"

test "a pull down closes a sheet, and a short pull does not"
  tap "bar-right"
  clock settle
  tap "menu-sheet" drag 0 40
  clock settle
  expect state sheet == "menu"
  tap "menu-sheet" drag 0 220
  clock settle
  expect state sheet == "none"
  expect state pull == 0

test "a pull up makes a sheet as tall as the screen allows, and a pull down returns it"
  tap "bar-middle"
  clock +300
  expect state sheetTall == false
  tap "sheet-scroll" drag 0 -120
  clock settle
  expect state sheetTall == true
  tap "sheet-field" drag 0 160 from 6 26
  clock settle
  expect state sheetTall == false
  expect state sheet == "search"

test "a pull down on a tall sheet's list moves the sheet, and the list stays at its top"
  tap "bar-right"
  clock settle
  tap "menu-sheet" drag 0 -120
  clock settle
  expect state sheetTall == true
  tap "menu-sheet" drag 0 160
  clock settle
  expect state sheetTall == false
  expect state sheet == "menu"

test "a control that is not built yet changes nothing"
  tap "bar-right"
  clock settle
  tap "menu-summarize"
  expect state sheet == "menu"
  expect state tabs.length == 1

test "the tabs button shows the grid, and Done returns to the page"
  tap "bar-left"
  clock +400
  clock settle
  expect state screen == "tabs"
  expect text "count" == "1"
  expect tree has "tab-1"
  tap "bar-right"
  clock +100
  expect state screen == "browse"
  expect tree has "page-cover"
  clock +800
  expect tree missing "page-cover"

test "a press on the bar while the grid is about to show opens no sheet"
  tap "bar-left"
  tap "bar-middle"
  tap "bar-right"
  clock +400
  clock settle
  expect state sheet == "none"
  expect state screen == "tabs"
  expect tree has "tab-1"

test "the plus button opens the search sheet for a new tab"
  tap "bar-left"
  clock +400
  clock settle
  tap "bar-middle"
  expect state sheet == "search"
  expect state composing == true
  expect state draft == ""
  type "address" "example.com"
  type "address" key "Enter"
  expect state sheet == "none"
  expect state screen == "browse"
  expect state tabs.length == 2
  expect state tabs.1.url == "https://example.com"
  expect state current == "2"
  clock +800
  expect state flyScale == 1

test "sharing from a second tab closes the page menu and keeps that tab open"
  tap "bar-left"
  clock +400
  clock settle
  tap "bar-middle"
  type "address" "example.com/article?story=2"
  type "address" key "Enter"
  clock settle
  tap "bar-right"
  clock settle
  tap "menu-share"
  expect state sheet == "none"
  expect state current == "2"
  expect state tabs.1.url == "https://example.com/article?story=2"

test "words in the field search, and are kept as a recent search"
  tap "bar-middle"
  type "address" "expo router native tabs"
  type "address" key "Enter"
  expect state recents == ["expo router native tabs"]
  expect state sheet == "none"

test "an address in the field is kept as a recent page, and a recent entry opens again"
  tap "bar-middle"
  type "address" "example.com"
  type "address" key "Enter"
  expect state recents == ["https://example.com"]
  tap "bar-middle"
  clock settle
  tap "recent-https://example.com"
  expect state sheet == "none"
  expect state recents == ["https://example.com"]

test "the control above the grid pages between private tabs and tabs"
  tap "bar-left"
  clock +400
  clock settle
  expect state privatePage == false
  tap "private"
  clock settle
  expect state privatePage == true
  expect tree has "page-private-empty"
  tap "bar-middle"
  type "address" "example.org"
  type "address" key "Enter"
  expect state tabs.1.private == true
  expect state recents == []
  tap "bar-left"
  clock +400
  clock settle
  expect state privatePage == true
  expect text "count" == "1"
  tap "regular"
  clock settle
  expect state privatePage == false

test "closing all tabs asks first, and the cards in view fly into the bin"
  tap "bar-left"
  clock +400
  clock settle
  tap "bar-left"
  expect state closing == "lift"
  expect state binCards.length == 1
  expect text "close-all-title" == "Close Tab"
  clock +100
  expect state closing == "in"
  tap "close-all-cancel"
  expect state closing == "back"
  expect state tabs.length == 1
  clock +500
  expect state closing == "none"
  expect tree missing "close-all"
  tap "bar-left"
  clock +100
  // As the alert comes in, its plain button stands in for the glass one, and closes the tabs.
  tap "close-all-stand-in"
  expect state closing == "drop"
  clock +200
  expect state closing == "hold"
  expect state tabs.length == 1
  clock +600
  expect state closing == "none"
  expect state tabs == []
  expect state current == ""
  expect tree missing "close-all"
  expect text "count" == "0"

test "the close-all alert counts the tabs on the page and names the tabs that stay"
  tap "bar-left"
  clock +400
  clock settle
  tap "bar-middle"
  type "address" "example.com"
  type "address" key "Enter"
  tap "bar-left"
  clock +400
  clock settle
  tap "private"
  clock settle
  tap "bar-middle"
  type "address" "example.org"
  type "address" key "Enter"
  tap "bar-left"
  clock +400
  clock settle
  tap "regular"
  clock settle
  tap "bar-left"
  clock +400
  expect state closing == "ready"
  expect text "close-all-title" == "Close All Tabs"
  expect text "close-all-confirm" == "Close 2 Tabs"
  expect text "close-all-note" == "Your private tabs stay open."
  tap "close-all-confirm"
  clock +600
  expect state tabs.length == 1
  expect state tabs.0 .private == true

test "a tab's close button closes it"
  tap "bar-left"
  clock +400
  clock settle
  tap "tab-close-1"
  expect state tabs == []

test "Close Tab in the page menu closes the page and shows the grid"
  tap "bar-right"
  clock settle
  tap "menu-close-tab"
  expect state tabs == []
  expect state sheet == "none"
  expect state screen == "tabs"

test "the close-all alert shows the cards in view in its bin"
  tap "bar-left"
  clock +400
  clock settle
  tap "bar-left"
  clock +800
  expect state closing == "ready"
  expect tree has "close-all-bin"
  expect text "close-all-title" == "Close Tab"
  expect text "close-all-confirm" == "Close Tab"
