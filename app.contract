// Exact Browser: the browser's chrome (Paper: "iOS Browser MVP"). A page fills the screen; the
// bar's three glass surfaces sit over it and become the search sheet, the page menu and the tab
// grid's controls. @ref LLP 0001
use Icon from "./icons.contract"
use hostOf, isAddress, addressOf, shortAddress from "./address.contract"
use Tab, TabPage, newTab from "./tabs.contract"
use SheetField, SearchSheet, MenuSheet from "./sheets.contract"
use BinCard, CloseAllAlert from "./close-all.contract"
use Fly, SheetContent, SheetShell, Fade, BarGrow, BarSettle, SheetPull, PictureIn, PictureOut, BarFill, AddressHere, AddressAway, AddressIn, AddressOut, BesideLowercase, ScrimIn, ScrimOut, GridScreen, SegmentThumb, Thumbnail, ThumbnailFace, Bare from "./design.contract"

font "Inter"
  100 900 = "assets/fonts/InterVariable.ttf"

shape Page
  platform: string

shape Segment
  x: number
  y: number
  width: number
  height: number

shape Viewport
  width: number
  height: number
  keyboardHeight: number
  horizontalViewportSegments: number
  segments: Segment[]
  safeAreaTop: number
  safeAreaBottom: number
  safeAreaLeft: number
  safeAreaRight: number

fn heightOf(text: string): number = match parseNumber(text) { case some(n) => n, case none => 336 }
fn shotPath(id: string, n: number): string = `app:/cache/tab-${id}-${n % 2}.png`

component ExactBrowser
  resource page = exactPage() as shape Page
  resource viewport = exactViewport() as shape Viewport

  state tabs = [newTab("1", "https://expo.dev/", false, 1)]
  state current = "1"
  state findTab = ""
  state findRequest = 0
  state nextId = 2
  // What is behind the bar: a page, or the tab grid.
  state screen = "browse"
  // What the bar's middle surface has grown into: "none", "search" or "menu".
  state sheet = "none"
  // The search sheet is for a new tab.
  state composing = false
  state draft = ""
  // What the person entered, the newest first: an address or the words of a search.
  state recents = [] persist
  // Sites' icons as "host address" pairs, the newest first.
  state icons: string[] = [] persist
  // How far a finger has pulled the open sheet, in points: down is more, up is less than 0.
  // @ref LLP 0001#sheet-pull
  state pull = 0
  // An open sheet is at its resting height, or as tall as the screen allows after a pull up.
  // @ref LLP 0001#sheet-height
  state sheetTall = false
  // The list in an open sheet is at its top. Then a pull down on it moves the sheet, and only a
  // pull up scrolls it. @ref LLP 0001#sheet-pull
  state listTop = true
  // The keyboard's height at each screen size, as "WxH height", the newest first.
  state keyboards: string[] = [] persist
  // A page's snapshot on its way between the screen and its card. "cover": it is over its page
  // while its picture loads. "drop": it covers the grid, which has just been shown. "down": it
  // flies to its card. "lift": it is on its card, and the grid is still shown. "up": it flies to
  // the screen. @ref LLP 0001#tab-flights
  state flight = "none"
  // Where the snapshot is drawn: its left, its top, and its scale against the screen.
  state flyX = 0
  state flyY = 0
  state flyScale = 1
  // The tabs button was pressed, and the page's snapshot is being taken.
  state leaving = false
  // A page finished loading: its snapshot is due.
  state snapDue = 0
  // The tab grid's pager: the page it shows, and the offset it opens at.
  state privatePage = false
  state pagerStart = 0
  // The close-all alert: "none", or its phase (`CloseAllAlert`). `binCards` are the cards that
  // were in view when it opened, and their places in the grid. @ref LLP 0001#close-all
  state closing = "none"
  state binCards: BinCard[] = []
  // The tabs on the page when the alert opened, and the tabs of the other kind. The alert keeps
  // its words while it leaves, after the tabs have closed.
  state closeCount = 0
  state closeOthers = 0
  // The current tab when the alert opened: its card keeps its ring in the stack.
  state closeSelected = ""

  // The screen, and the pane the controls sit in: the trailing half of a book fold, else all of it.
  derive w = viewport.width
  derive h = viewport.height
  derive book = viewport.horizontalViewportSegments == 2
  derive paneX = book ? (match viewport.segments.at(1) { case some(s) => s.x, case none => 0 }) : 0
  derive paneW = book ? (match viewport.segments.at(1) { case some(s) => s.width, case none => w }) : w
  // Regular: an unfolded iPhone Duo. The bar and the sheets float at a fixed width there.
  derive regular = w >= 600
  derive portrait = h >= w
  // The keyboard's height, known before the keyboard is up, so a sheet grows to its place once.
  // It is the height last seen at this screen size, and 336 points before the first.
  // @ref LLP 0001#keyboard-height
  derive screenKey = `${w}x${h} `
  derive keyboardUp = viewport.keyboardHeight >= 120
  derive keyboardSeen = match first(keyboards.filter(k => k.startsWith(screenKey))) { case some(k) => heightOf(k.slice(screenKey.length)), case none => 336 }
  derive keyboard = keyboardUp ? viewport.keyboardHeight : keyboardSeen

  derive open = sheet != "none"
  derive inTabs = screen == "tabs"
  derive active = first(tabs.filter(t => t.id == current))
  derive url = match active { case some(t) => t.url, case none => "" }
  derive activePrivate = match active { case some(t) => t.private, case none => privatePage }
  derive recent = sortBy(tabs, t => t.seen, "desc")
  derive regularTabs = tabs.filter(t => not t.private)
  derive privateTabs = tabs.filter(t => t.private)
  derive shownTabs = privatePage ? privateTabs : regularTabs
  derive asking = closing != "none"
  derive awayIds = asking ? binCards.map(c => c.tab.id) : []

  // The bar. @ref LLP 0001#bar-geometry
  derive barW = regular ? 381 : w - 24
  derive barX = regular ? paneX + (paneW - 381) / 2 : 12
  derive barBottom = regular ? (portrait ? 32 : 24) : 34
  derive sideSize = inTabs ? 52 : 48
  // While a sheet is open the side buttons are off the screen: past its sides where the sheet is
  // the full width, and below it where the sheet is narrower. @ref LLP 0001#one-spring
  derive sideBottom = open and regular ? -76 : inTabs ? 40 : barBottom
  derive leftX = open and not regular ? -76 : inTabs ? paneX + 24 : barX
  derive rightX = open and not regular ? w + 24 : inTabs ? paneX + paneW - 76 : barX + barW - 48
  // The sheets. A sheet is a panel as tall as the screen allows, attached to the bottom of the
  // screen. At rest only its top part is on the screen, and a pull up shows all of it. It reaches
  // 44 points below what it shows so its four corners are one radius. @ref LLP 0001#sheet-height
  derive sheetW = regular ? 401 : w
  derive sheetX = regular ? paneX + (paneW - 401) / 2 : 0
  // How far each side safe area reaches into a sheet's box. The sheet's content stays clear of
  // it: the folded Duo's status rail covers the trailing edge of a compact sheet.
  // @ref LLP 0001#sheet-insets
  derive sheetInsetLeft = max(0, viewport.safeAreaLeft - sheetX)
  derive sheetInsetRight = max(0, sheetX + sheetW - (w - viewport.safeAreaRight))
  derive contentW = sheetW - sheetInsetLeft - sheetInsetRight
  // A sheet's top is never above the status bar and 8 points. At rest the search sheet shows its
  // field and the recent entries above the keyboard, and the page menu shows its content.
  derive fullShown = h - viewport.safeAreaTop - 8
  derive restShown = min(fullShown, sheet == "search" ? min(304 + keyboard, h - 118) : min(640, h - 74))
  derive sheetTaller = fullShown > restShown
  derive shown = sheetTall ? fullShown : restShown
  derive sheetBottom = shown - fullShown - 44
  derive midX = open ? sheetX : inTabs ? paneX + (paneW - 120) / 2 : barX + 58
  derive midBottom = open ? sheetBottom : sideBottom
  derive midW = open ? sheetW : inTabs ? 120 : barW - 116
  derive midH = open ? fullShown + 44 : sideSize
  derive sheetTop = h - shown
  derive midRadius = open ? (regular ? 32 : 44) : sideSize / 2

  // The tab grid. @ref LLP 0001#tab-grid
  derive columns = regular ? (portrait ? 3 : 4) : 2
  // Across a book fold the grid is two columns a side: the card after the hinge starts past it.
  derive hinge = book ? paneX - (match first(viewport.segments) { case some(s) => s.width, case none => paneX }) : 0
  // Each side keeps its 16-point margin; the grid's own 14-point gap is already between the cards.
  derive hingeGap = book ? hinge + 18 : 0
  derive cardW = floor((w - 32 - 14 * (columns - 1) - hingeGap) / columns)
  derive previewH = round(cardW * h / w)
  // The control keeps 16 points from the top edge where the device reports no top safe area, as
  // the iPhone Duo does. The grid starts below it: the inset, 4 points, the control, 28 points.
  derive gridInsetTop = max(viewport.safeAreaTop, 16)
  derive gridTop = gridInsetTop + 80
  // The flying snapshot's bottom corners are its card's (`radius.xl`, 22 points) at the card's size.
  derive flyRadius = 22 / flyScale

  task leave when leaving
    after(300, showGrid)
  // 30 ms after the grid is shown it is laid out, and its card can be measured. A flight ends 700
  // ms after it starts: `Fly` takes 450 ms.
  task settle when flight == "drop"
    after(30, shrink)
  task takeOff when flight == "lift"
    after(30, rise)
  task land when flight == "down" or flight == "up" key=flight
    after(700, landed)
  // The field takes focus after the sheet has grown (`BarGrow` is almost at rest after 250 ms):
  // bringing the keyboard up stops the frames of a spring that is still moving.
  // @ref LLP 0001#sheet-focus
  task focusField when sheet == "search"
    after(250, focusAddress)
  task learnKeyboard when sheet == "search" and keyboardUp and viewport.keyboardHeight != keyboardSeen
    after(400, rememberKeyboard)
  task snap when snapDue > 0 key=snapDue
    after(900, snapPage)
  // The close-all alert is drawn in its first state, and one frame later it moves. The cards rise
  // over the bin for 110 ms, then sink into it. After Close
  // the cards fall into the bin, the empty bin holds for 150 ms, and the alert leaves. The tabs
  // close when it has gone: closing them removes their pages, which stops the frames for a moment.
  // @ref LLP 0001#close-all
  task askClose when closing == "lift"
    after(16, showCloseAll)
  task binSink when closing == "in"
    after(110, sinkCloseAll)
  task binReady when closing == "rest"
    after(260, readyCloseAll)
  task binFall when closing == "drop"
    after(130, emptyBin)
  task binHold when closing == "hold"
    after(150, leaveCloseAll)
  task binGone when closing == "out"
    after(220, closedAll)
  task binBack when closing == "back"
    after(400, closedAll)

  // Pages.
  action started(id: string, e: FrameNavigation)
    tabs = tabs.map(t => t.id == id ? Tab(t, url=(e.url != "" ? e.url : t.url)) : t)
  action moved(id: string, e: FrameNavigation)
    tabs = tabs.map(t => t.id == id ? Tab(t, url=e.url, title=e.title, canGoBack=e.canGoBack, canGoForward=e.canGoForward) : t)
  action arrived(id: string, e: FrameNavigation)
    let icon = match first(e.icons) { case some(i) => i, case none => "" }
    let host = hostOf(e.url)
    let private = tabs.filter(t => t.id == id and t.private).length > 0
    tabs = tabs.map(t => t.id == id ? Tab(t, url=e.url, title=e.title, icon=icon, canGoBack=e.canGoBack, canGoForward=e.canGoForward) : t)
    // A private tab leaves no icon behind.
    if icon != "" and not private
      icons = [`${host} ${icon}`].concat(icons.filter(i => not i.startsWith(`${host} `))).slice(0, 80)
    if id == current
      snapDue = snapDue + 1
  action captured(id: string, e: FrameCapture)
    if e.error == ""
      tabs = tabs.map(t => t.id == id ? Tab(t, shot=e.path, shots=t.shots + 1) : t)
    if leaving
      flight = "cover"
  action snapPage
    snapDue = 0
    if not inTabs and not open and not leaving and flight == "none"
      match active
        case some(t)
          captureScreenshot(`frame-${t.id}`, shotPath(t.id, t.shots + 1))
        case none
          snapDue = 0
  action asked(e: FrameNewWindow)
    let id = `${nextId}`
    tabs = tabs.concat([newTab(id, e.url, activePrivate, performanceNow())])
    nextId = nextId + 1
    current = id

  // The bar: each surface has one button, whose job follows the screen.
  action pressLeft
    if inTabs
      if shownTabs.length > 0 and not asking
        // The cards in view, read where they are drawn now. At most five go into the stack.
        let cards = shownTabs.map(t => BinCard(tab=t, at=frame(`card-${t.id}`)))
        binCards = cards.filter(c => c.at.width > 0 and c.at.y < h and c.at.y + c.at.height > 0 and c.at.x < w and c.at.x + c.at.width > 0).slice(0, 5)
        closeSelected = current
        closeCount = shownTabs.length
        closeOthers = privatePage ? regularTabs.length : privateTabs.length
        closing = "lift"
    else
      match active
        case some(t)
          leaving = true
          captureScreenshot(`frame-${t.id}`, shotPath(t.id, t.shots + 1))
        case none
          screen = "tabs"
          pagerStart = privatePage ? 0 : w
  // The grid shows when the snapshot's picture is drawn (`coverLoaded`), or after 300 ms.
  action coverLoaded
    if flight == "cover"
      leaving = false
      screen = "tabs"
      privatePage = activePrivate
      pagerStart = activePrivate ? 0 : w
      flight = "drop"
      scrollIntoView(`preview-${current}`, block="nearest")
  action showGrid
    leaving = false
    screen = "tabs"
    privatePage = activePrivate
    pagerStart = activePrivate ? 0 : w
    flight = "drop"
    scrollIntoView(`preview-${current}`, block="nearest")
  // The snapshot covers the screen; it goes to its card, where the card is drawn now.
  action shrink
    let card = frame(`preview-${current}`)
    if card.width > 0
      flyX = card.x
      flyY = card.y
      flyScale = card.width / w
      flight = "down"
    else
      flight = "none"
  // The snapshot is on its card; the page takes the grid's place under it, and it goes to the
  // screen.
  action rise
    screen = "browse"
    flyX = 0
    flyY = 0
    flyScale = 1
    flight = "up"
  // A press while the page's snapshot is taken does nothing: the grid is about to show.
  action pressMiddle
    if not leaving
      composing = inTabs
      draft = inTabs ? "" : url
      sheetTall = false
      listTop = true
      sheet = "search"
  action focusAddress
    focus("address")
    selectText("address")
  action rememberKeyboard
    keyboards = [`${screenKey}${viewport.keyboardHeight}`].concat(keyboards.filter(k => not k.startsWith(screenKey))).slice(0, 8)
  // The address in the page menu's top row: the menu becomes the search sheet.
  action editAddress
    composing = false
    draft = url
    listTop = true
    sheet = "search"
  // The sheet follows the finger: down without a limit, and up as far as its full height.
  action pullSheet(dx: number, dy: number)
    if open
      pull = max(shown - fullShown, pull + dy)
  // A sheet let go 64 points up (or half of the way it can grow, if that is less), or flicked up,
  // becomes tall. Let go 96 points down, or flicked down, a tall sheet returns to its resting
  // height and a resting sheet closes.
  action dropSheet(vx: number, vy: number)
    let up = pull < 0 - min(64, (fullShown - restShown) / 2) or vy < -600
    let down = not up and (pull > 96 or vy > 600)
    if open and down and not (sheetTall and sheetTaller)
      blur()
      sheet = "none"
      composing = false
    sheetTall = sheetTaller and (up or (sheetTall and not down))
    pull = 0
  action listScrolled(x: number, y: number)
    listTop = y <= 0
  // The screen changed size: the device folded, unfolded or turned. An open sheet closes.
  // @ref LLP 0001#sheet-height
  action screenResized(width: number, height: number)
    if open
      blur()
      sheet = "none"
      composing = false
  action pressRight
    if inTabs
      if current != ""
        let card = frame(`preview-${current}`)
        if card.width > 0
          flyX = card.x
          flyY = card.y
          flyScale = card.width / w
          flight = "lift"
        else
          screen = "browse"
    else if not leaving
      sheetTall = false
      listTop = true
      sheet = "menu"
  action closeSheet
    blur()
    sheet = "none"
    composing = false

  // The search sheet.
  action edit(text: string)
    draft = text
  action fill(text: string)
    draft = isAddress(text) ? shortAddress(text) : text
    focus("address")
  action submit
    let text = draft.trim()
    let private = composing ? privatePage : activePrivate
    if text != ""
      // A private tab leaves no recent entry behind.
      if not private
        recents = [isAddress(text) ? addressOf(text) : text].concat(recents.filter(r => r != text and r != addressOf(text))).slice(0, 12)
      if composing or current == ""
        let id = `${nextId}`
        tabs = tabs.concat([newTab(id, addressOf(text), private, performanceNow())])
        nextId = nextId + 1
        current = id
        screen = "browse"
      else
        navigate(`frame-${current}`, addressOf(text))
      blur()
      sheet = "none"
      composing = false
  action pick(entry: string)
    let private = composing ? privatePage : activePrivate
    if not private
      recents = [entry].concat(recents.filter(r => r != entry)).slice(0, 12)
    if composing or current == ""
      let id = `${nextId}`
      tabs = tabs.concat([newTab(id, addressOf(entry), private, performanceNow())])
      nextId = nextId + 1
      current = id
      screen = "browse"
    else
      navigate(`frame-${current}`, addressOf(entry))
    blur()
    sheet = "none"
    composing = false

  // The page menu.
  action goBack
    traverseHistory(`frame-${current}`, -1)
  action goForward
    traverseHistory(`frame-${current}`, 1)
  action reloadPage
    reload(`frame-${current}`)
    sheet = "none"
  action toggleDesktopSite
    tabs = tabs.map(t => t.id == current ? Tab(t, desktopSite=not t.desktopSite) : t)
    sheet = "none"
  action copyLink
    copyText(url)
    haptic("success")
    sheet = "none"
  action sharePage
    share(url=url)
    sheet = "none"
  action findOnPage
    findTab = current
    findRequest = findRequest + 1
    sheet = "none"
  action closeCurrent
    let rest = recent.filter(t => t.id != current and t.private == activePrivate)
    tabs = tabs.filter(t => t.id != current)
    current = match first(rest) { case some(t) => t.id, case none => "" }
    sheet = "none"
    if rest.length == 0
      screen = "tabs"
      privatePage = activePrivate
      pagerStart = activePrivate ? 0 : w
  // TODO(TODO.md): a control that is designed but does nothing yet.
  action later
    sheet = sheet

  // The tab grid.
  action paged(x: number, y: number)
    privatePage = x < w / 2
  action showPrivate
    scrollIntoView("page-private", block="nearest", inline="start", behavior="smooth")
  action showRegular
    scrollIntoView("page-regular", block="nearest", inline="start", behavior="smooth")
  action openTab(id: string)
    tabs = tabs.map(t => t.id == id ? Tab(t, seen=performanceNow()) : t)
    current = id
    let card = frame(`preview-${id}`)
    if card.width > 0
      flyX = card.x
      flyY = card.y
      flyScale = card.width / w
      flight = "lift"
    else
      screen = "browse"
  action landed
    flight = "none"
    flyX = 0
    flyY = 0
    flyScale = 1
  action closeTab(id: string)
    let rest = recent.filter(t => t.id != id and t.private == privatePage)
    tabs = tabs.filter(t => t.id != id)
    if id == current
      current = match first(rest) { case some(t) => t.id, case none => "" }
  // The close-all alert. Close drops the cards into the bin; the tabs close when it has gone.
  action showCloseAll
    if closing == "lift"
      closing = "in"
  action sinkCloseAll
    if closing == "in"
      closing = "rest"
  action readyCloseAll
    if closing == "rest"
      closing = "ready"
  action closeAll
    if closing == "in" or closing == "rest" or closing == "ready"
      closing = "drop"
  action emptyBin
    if closing == "drop"
      closing = "hold"
  action keepAll
    if closing == "lift" or closing == "in" or closing == "rest" or closing == "ready"
      closing = "back"
  action leaveCloseAll
    closing = "out"
  action closedAll
    if closing == "out"
      tabs = tabs.filter(t => t.private != privatePage)
      if activePrivate == privatePage
        current = ""
    closing = "none"
    binCards = []

  view
    main testId="root" resize=screenResized viewport-fit="cover" width="100%" height="100%" position="relative" overflow="hidden" font-family="Inter" color="color.text" background-color=(inTabs ? "color.surface" : "color.background") interactive-widget="overlays-content" status-bar-style=(inTabs ? "dark-content" : "auto")
      // The data words tell the page's web view where the status bar ends and where the bar's
      // top is, with 8 points of room: the page lays its fixed content out between those lines
      // and still scrolls under both. @ref LLP 0001#page-insets
      // Every tab's page stays mounted. The front one stays shown, under the grid too: showing a
      // hidden frame again stalls. @ref LLP 0001#pages
      for t in tabs key=t.id
        iframe t.src id=`frame-${t.id}` hatch="page" data-top=`${viewport.safeAreaTop}` data-home=`${viewport.safeAreaBottom}` data-bar=`${barBottom + 56}` partition=(t.private ? "private" : "persist:browser") testId=`frame-${t.id}` title=t.title
          data-find=`${t.id == findTab ? findRequest : 0}`
          position="absolute" left=0 top=0 width=w height=h border="none" display=(t.id == current ? "flex" : "none")
          apple.allowsBackForwardNavigationGestures=true
          data-desktop=(t.desktopSite ? "true" : "false")
          navigate=started(t.id) currententrychange=moved(t.id) navigatesuccess=arrived(t.id) capture=captured(t.id) newwindow=asked

      if not inTabs and current == ""
        box position="absolute" left=0 top=0 width=w height=h background-color="color.surface"

      if inTabs
        column position="absolute" left=0 top=0 width=w height=h background-color="color.surface" color-scheme="light" timeline-scope="--pager" inert=asking class=GridScreen testId="grid"
          // Private tabs and regular tabs are two pages: a swipe, or a press on the control,
          // goes between them. @ref LLP 0001#tab-pager
          scroll id="pager" position="absolute" left=0 top=0 width=w height=h display="flex" flex-direction="row" overflow-x="scroll" overflow-y="hidden" scroll-snap-type="x mandatory" scrollbar-width="none" scroll-timeline="--pager x" scrollLeft=pagerStart scroll=paged testId="pager"
            TabPage(id="page-private", tabs=privateTabs, current=current, empty="No private tabs", width=w, height=h, top=gridTop, columns=columns, cardWidth=cardW, previewHeight=previewH, hingeGap=hingeGap, away=awayIds, open=openTab, close=closeTab)
            TabPage(id="page-regular", tabs=regularTabs, current=current, empty="No tabs", width=w, height=h, top=gridTop, columns=columns, cardWidth=cardW, previewHeight=previewH, hingeGap=hingeGap, away=awayIds, open=openTab, close=closeTab)
          box position="absolute" left=0 top=0 width=w height=(gridTop - 12) pointer-events="none" background-image="linear-gradient(0deg, rgba(245, 245, 245, 0) 0%, #f5f5f5 55%)"
          // The control is 156 by 48 with its 4-point padding inside, so the thumb (72 by 40) has 4
          // points on every side.
          row position="absolute" left=((w - 156) / 2) top=(gridInsetTop + 4) width=156 height=48 box-sizing="border-box" padding=4 gap=4 align-items="center" border-radius="radius.full" background-color="color.surface-raised"
            box class=SegmentThumb animation-range=`0px ${w}px`
            button press=showPrivate class=Bare position="relative" width=72 height=44 margin="-2px 0px" display="flex" align-items="center" justify-content="center" border-radius="radius.full" aria-label="Private Tabs" aria-pressed=privatePage testId="private"
              Icon(name="private", size=20, color=(privatePage ? "color.text" : "color.text-secondary"), weight=500)
            button press=showRegular class=Bare position="relative" width=72 height=44 margin="-2px 0px" display="flex" align-items="center" justify-content="center" border-radius="radius.full" aria-label=`${regularTabs.length} ${regularTabs.length == 1 ? "tab" : "tabs"}` aria-pressed=(not privatePage) testId="regular"
              row min-width=22 height=22 padding-left=3 padding-right=3 align-items="center" justify-content="center" border-radius=7 border-width=2 border-style="solid" border-color=(privatePage ? "color.text-secondary" : "color.text")
                text `${regularTabs.length}` font-size=12 font-weight=700 color=(privatePage ? "color.text-secondary" : "color.text") testId="count"
          box position="absolute" left=0 bottom=0 width=w height=132 pointer-events="none" background-image="linear-gradient(180deg, rgba(245, 245, 245, 0) 0%, #f5f5f5 45%)"

      // A page's snapshot on its way between the screen and its card. It is drawn here, under the
      // bar, and moves by a transform, so the bar stays over it. @ref LLP 0001#tab-flights
      if flight != "none"
        match active
          case some(t)
            if t.shot != ""
              image t.shot load=coverLoaded class=Fly position="absolute" left=0 top=0 width=w height=h translate=`${flyX}px ${flyY}px` scale=flyScale border-radius=`0px 0px ${flyRadius}px ${flyRadius}px` object-fit="cover" object-position="top" alt="" pointer-events="none" testId="page-cover"
            else
              box class=Fly position="absolute" left=0 top=0 width=w height=h translate=`${flyX}px ${flyY}px` scale=flyScale border-radius=`0px 0px ${flyRadius}px ${flyRadius}px` background-color="color.background" pointer-events="none" testId="page-cover"
          case none
            box

      // Behind an open sheet the page is darker, and a press there closes the sheet.
      // @ref LLP 0001#scrim
      box class=(open ? ScrimIn : ScrimOut) aria-hidden=true testId="scrim-layer"
      if open
        button press=closeSheet class=Bare position="absolute" left=0 top=0 width=w height=sheetTop aria-label="Close" testId="scrim"
        if regular
          button press=closeSheet class=Bare position="absolute" left=0 top=sheetTop width=sheetX height=(h - sheetTop) aria-label="Close" testId="scrim-leading"
          button press=closeSheet class=Bare position="absolute" left=(sheetX + sheetW) top=sheetTop width=(w - sheetX - sheetW) height=(h - sheetTop) aria-label="Close" testId="scrim-trailing"

      // The bar's three glass surfaces. Each keeps its place in the tree through every state, so
      // one spring carries it between them. @ref LLP 0001#one-spring
      // A finger that pulls the sheet moves this layer. The middle surface morphs inside it.
      SheetPull(pull=pull, open=open, width=w, height=h)
        column class=(open ? BarGrow : BarSettle) pan=pullSheet panrelease=dropSheet touch-action="none" pointer-events="auto" color-scheme="light" position="absolute" left=midX bottom=midBottom width=midW height=midH border-radius=midRadius overflow="clip" -exact-glass-tint=(open ? "glass.sheet" : inTabs ? "glass.accent" : "transparent") box-shadow=(open ? "0 -12px 40px rgba(40, 10, 30, 0.18)" : inTabs ? "0 6px 16px rgba(0, 0, 0, 0.16)" : "0 8px 24px rgba(40, 10, 20, 0.18)") testId="bar-middle-surface"
          box class=BarFill background-color="color.accent" opacity=(inTabs and not open ? 0.8 : 0)
          if open
            // What the sheet holds ends at the bottom of the screen, or at the keyboard's top. It
            // scrolls where the sheet shows all of itself and cannot grow. @ref LLP 0001#sheet-height
            column class=SheetShell position="absolute" left=sheetInsetLeft top=0 width=contentW height=(shown - viewport.keyboardHeight) padding-top="space-4" gap=(sheet == "search" ? 14 : 18)
              column class=SheetContent flex-shrink=0 padding-left="space-4" padding-right="space-4"
                SheetField(mode=sheet, draft=draft, canGoBack=(match active { case some(t) => t.canGoBack, case none => false }), canGoForward=(match active { case some(t) => t.canGoForward, case none => false }), edit=edit, submit=submit, fill=fill, goBack=goBack, goForward=goForward, copyLink=copyLink, reloadPage=reloadPage, editAddress=editAddress)
              if sheet == "search"
                scroll class=SheetContent flex=1 min-height=0 scroll=listScrolled overflow-y=(sheetTall or not sheetTaller ? "scroll" : "hidden") touch-action=(listTop ? "pan-down" : "pan-y") padding-left="space-4" padding-right="space-4" padding-bottom=(keyboardUp ? 16 : viewport.safeAreaBottom + 16) testId="sheet-scroll"
                  SearchSheet(recents=recents, icons=icons, pick=pick, fill=fill)
              else
                scroll class=SheetContent flex=1 min-height=0 scroll=listScrolled overflow-y=(sheetTall or not sheetTaller ? "scroll" : "hidden") touch-action=(listTop ? "pan-down" : "pan-y") padding-left="space-4" padding-right="space-4" padding-bottom=(viewport.safeAreaBottom + 16) testId="sheet-scroll"
                  MenuSheet(closeTab=closeCurrent, sharePage=sharePage, canFind=(page.platform == "ios" and current != ""), findOnPage=findOnPage, canRequestDesktop=(page.platform == "ios"), desktopSite=(match active { case some(t) => t.desktopSite, case none => false }), toggleDesktopSite=toggleDesktopSite, later=later)
          else
            button press=pressMiddle class=Bare position="absolute" left=0 top=0 width=midW height=sideSize aria-label=(inTabs ? "New Tab" : `Address, ${hostOf(url)}`) inert=asking testId="bar-middle"
          // The address: centred in the pill and in the page menu's top row, and on its way to the
          // field's text in the search sheet. @ref LLP 0001#address-flight
          row position="absolute" left=(sheet == "search" ? sheetInsetLeft + 34 : open ? sheetInsetLeft + 16 : 0) top=(open ? 16 : 0) width=(sheet == "search" ? contentW - 100 : open ? contentW - 32 : midW) height=(open ? 52 : sideSize) align-items="center" justify-content=(sheet == "search" ? "flex-start" : "center") gap=6 pointer-events="none"
            if not open and not inTabs and url != ""
              box class=Fade display="flex"
                box class=BesideLowercase
                  Icon(name=(url.startsWith("https://") ? "lock" : "unlock"), size=13, color="-exact-label", weight=600)
            box class=(sheet == "search" ? AddressAway : AddressHere)
              text (sheet == "menu" ? shortAddress(url) : hostOf(url)) class=(inTabs ? AddressOut : AddressIn) color=(sheet == "menu" ? "color.text" : "-exact-label") min-width=0 line-clamp=1 testId="address-label"
          box class=(inTabs and not open ? PictureIn : PictureOut)
            Icon(name="plus", size=20, color="color.on-accent", weight=600)

      column class=(open ? BarGrow : BarSettle) color-scheme="light" position="absolute" left=leftX bottom=sideBottom width=sideSize height=sideSize border-radius=(sideSize / 2) overflow="clip" -exact-glass-tint=(inTabs ? "glass.control" : "transparent") testId="bar-left-surface"
        box class=BarFill background-color="color.surface-raised" opacity=(inTabs ? 0.7 : 0)
        button press=pressLeft class=Bare position="absolute" left=0 top=0 width=sideSize height=sideSize aria-label=(inTabs ? "Close All Tabs" : "Tabs") inert=(open or asking) testId="bar-left"
          box class=(inTabs ? PictureOut : PictureIn)
            // The two most recent tabs, the front one on top.
            box width=26 height=26 position="relative"
              box class=Thumbnail left=1 top=7 rotate="-18deg" background-color="thumbnail.behind"
                box class=ThumbnailFace
                  match recent.at(1)
                    case some(t)
                      if t.shot != ""
                        image t.shot width=15 height=17 object-fit="cover" object-position="top" alt="" opacity=0.85
                    case none
                      box
              box class=Thumbnail left=9 top=1 rotate="12deg" background-color="paper-white"
                box class=ThumbnailFace
                  match recent.at(0)
                    case some(t)
                      if t.shot != ""
                        image t.shot width=15 height=17 object-fit="cover" object-position="top" alt=""
                    case none
                      box
          box class=(inTabs ? PictureIn : PictureOut)
            Icon(name="close-all", size=19, color="color.text", weight=500)

      column class=(open ? BarGrow : BarSettle) color-scheme="light" position="absolute" left=rightX bottom=sideBottom width=sideSize height=sideSize border-radius=(sideSize / 2) overflow="clip" -exact-glass-tint=(inTabs ? "glass.control" : "transparent") testId="bar-right-surface"
        box class=BarFill background-color="color.surface-raised" opacity=(inTabs ? 0.7 : 0)
        button press=pressRight class=Bare position="absolute" left=0 top=0 width=sideSize height=sideSize aria-label=(inTabs ? "Done" : "Page Menu") inert=(open or asking) testId="bar-right"
          box class=(inTabs ? PictureOut : PictureIn)
            Icon(name="chevron-up", size=17, color="-exact-label", weight=600)
          box class=(inTabs ? PictureIn : PictureOut)
            Icon(name="checkmark", size=18, color="color.text", weight=600)

      // Over everything, the bar too. @ref LLP 0001#close-all
      if asking
        CloseAllAlert(phase=closing, cards=binCards, current=closeSelected, private=privatePage, count=closeCount, others=closeOthers, width=w, height=h, centerX=(paneX + paneW / 2), safeTop=viewport.safeAreaTop, safeBottom=viewport.safeAreaBottom, cardWidth=cardW, previewHeight=previewH, confirm=closeAll, cancel=keepAll)
